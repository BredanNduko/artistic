# --- core -------------------------------------------------------------
APP_ENV=development                     # "production" enables strict startup checks
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:///./data/designforge.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:8000   # used to build asset URLs the browser loads

# --- session cookie ---------------------------------------------------
# Same-site (localhost:5173 -> localhost:8000): Lax + insecure is fine.
# Frontend and API on different sites in production: COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- AI ---------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5              # design generation / editing
AI_FAST_MODEL=claude-haiku-4-5-20251001 # copywriting / suggestions
AI_DAILY_LIMIT=100                      # requests per user per UTC day
AI_PER_MINUTE_LIMIT=10
