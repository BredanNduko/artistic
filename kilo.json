{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --delete*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout -- *": "deny",
      "git restore*": "deny",
      "git branch -D*": "deny",
      "git rebase*": "deny",
      "git commit --amend*": "deny",
      "git stash*": "deny",
      "rm -rf*": "deny",
      "Remove-Item -Recurse*": "deny",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git fetch*": "allow",
      "git remote*": "allow",
      "git config --get*": "allow",
      "git check-ignore*": "allow",
      "git switch*": "ask",
      "git merge*": "ask",
      "npm run lint": "allow",
      "npm run build": "allow",
      "npm run dev": "allow",
      "npm run preview": "allow",
      "npm ci": "allow",
      "npm install": "allow",
      "npm ls*": "allow",
      "npm audit*": "allow",
      "npx tsc*": "allow",
      "npx oxlint*": "allow",
      "pytest*": "allow",
      "python -m pytest*": "allow",
      "python -m compileall*": "allow",
      "pip install -r*": "allow",
      "pip list*": "allow",
      "python --version": "allow",
      "node --version": "allow",
      "*": "ask"
    },
    "edit": {
      ".git/*": "deny",
      "*": "allow"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "ask"
  }
}